set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)

if(NOT BRIDGED_LLVM_BIN)
  message(FATAL_ERROR "Set BRIDGED_LLVM_BIN to the pinned LLVM 23.1.2 bin directory")
endif()
file(TO_CMAKE_PATH "${BRIDGED_LLVM_BIN}" BRIDGED_LLVM_BIN)
set(BRIDGED_LLVM_EXECUTABLE_SUFFIX "")
if(CMAKE_HOST_WIN32)
  set(BRIDGED_LLVM_EXECUTABLE_SUFFIX ".exe")
endif()
set(CMAKE_CXX_COMPILER "${BRIDGED_LLVM_BIN}/clang++${BRIDGED_LLVM_EXECUTABLE_SUFFIX}")
set(CMAKE_CXX_COMPILER_TARGET i686-pc-windows-msvc)
set(CMAKE_ASM_COMPILER "${CMAKE_CXX_COMPILER}")
set(CMAKE_ASM_COMPILER_TARGET i686-pc-windows-msvc)
set(CMAKE_LINKER "${BRIDGED_LLVM_BIN}/lld-link${BRIDGED_LLVM_EXECUTABLE_SUFFIX}")
set(CMAKE_AR "${BRIDGED_LLVM_BIN}/llvm-ar${BRIDGED_LLVM_EXECUTABLE_SUFFIX}")
set(CMAKE_RANLIB "${BRIDGED_LLVM_BIN}/llvm-ranlib${BRIDGED_LLVM_EXECUTABLE_SUFFIX}")
set(CMAKE_RC_COMPILER "${BRIDGED_LLVM_BIN}/llvm-rc${BRIDGED_LLVM_EXECUTABLE_SUFFIX}")
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES BRIDGED_LLVM_BIN)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)

# Link directly with LLD. Driver discovery of an installed VC toolchain would
# select unpinned defaults; the project supplies every target import library.
set(CMAKE_CXX_STANDARD_LIBRARIES "")
set(CMAKE_CXX_CREATE_SHARED_LIBRARY
  "<CMAKE_LINKER> /dll /machine:x86 /nodefaultlib /timestamp:0 /entry:_DllMainCRTStartup@12 /out:<TARGET> /implib:<TARGET_IMPLIB> <LINK_FLAGS> <OBJECTS> <LINK_LIBRARIES>")
